import io
import os
import re
import requests
import json
import hashlib
import base64

from PIL import Image, ImageDraw


JELLYFIN_URL = os.environ.get(
    "JELLYFIN_URL",
    "http://jellyfin:8096"
)

API_KEY = os.environ.get("JELLYFIN_API_KEY")

FORCE_REBUILD = os.environ.get(
    "FORCE_REBUILD",
    "false"
).lower() in ("1", "true", "yes")

OUTPUT_DIR = "/app/output"
ORIGINAL_DIR = "/app/originals"
STATE_FILE = "/app/state.json"

if not API_KEY:
    raise RuntimeError(
        "JELLYFIN_API_KEY environment variable is missing."
    )


HEADERS = {
    "Authorization": f'MediaBrowser Token="{API_KEY}"'
}


LANGUAGE_OVERRIDES = {
    "One Piece: Stampede": ["jpn"],
}


LANGUAGE_MAP = {
    "eng": "eng",
    "en": "eng",

    "deu": "deu",
    "ger": "deu",
    "de": "deu",

    "jpn": "jpn",
    "ja": "jpn",

    "kor": "kor",
    "ko": "kor",

    "fra": "fra",
    "fre": "fra",
    "fr": "fra",

    "und": "eng",
}


def normalize_language(language):
    if language is None:
        return "eng"

    language = language.lower().strip()

    return LANGUAGE_MAP.get(
        language,
        language
    )


def get_languages(movie):
    name = movie["Name"]

    if name in LANGUAGE_OVERRIDES:
        return LANGUAGE_OVERRIDES[name]

    languages = []

    for stream in movie.get("MediaStreams", []):
        if stream.get("Type") != "Audio":
            continue

        language = normalize_language(
            stream.get("Language")
        )

        if language not in languages:
            languages.append(language)

    return languages


def draw_german_flag(draw, x, y, width, height):
    stripe_height = height // 3

    draw.rectangle(
        (
            x,
            y,
            x + width,
            y + stripe_height
        ),
        fill=(0, 0, 0)
    )

    draw.rectangle(
        (
            x,
            y + stripe_height,
            x + width,
            y + stripe_height * 2
        ),
        fill=(221, 0, 0)
    )

    draw.rectangle(
        (
            x,
            y + stripe_height * 2,
            x + width,
            y + height
        ),
        fill=(255, 206, 0)
    )


def draw_japanese_flag(draw, x, y, width, height):
    draw.rectangle(
        (
            x,
            y,
            x + width,
            y + height
        ),
        fill=(255, 255, 255)
    )

    radius = int(height * 0.30)

    center_x = x + width // 2
    center_y = y + height // 2

    draw.ellipse(
        (
            center_x - radius,
            center_y - radius,
            center_x + radius,
            center_y + radius
        ),
        fill=(188, 0, 45)
    )

def draw_french_flag(draw, x, y, width, height):
    stripe_width = width // 3

    draw.rectangle(
        (
            x,
            y,
            x + stripe_width,
            y + height
        ),
        fill=(0, 35, 149)
    )

    draw.rectangle(
        (
            x + stripe_width,
            y,
            x + stripe_width * 2,
            y + height
        ),
        fill=(255, 255, 255)
    )

    draw.rectangle(
        (
            x + stripe_width * 2,
            y,
            x + width,
            y + height
        ),
        fill=(237, 41, 57)
    )

def draw_korean_flag(draw, x, y, width, height):
    draw.rectangle(
        (
            x,
            y,
            x + width,
            y + height
        ),
        fill=(255, 255, 255)
    )

    center_x = x + width // 2
    center_y = y + height // 2

    radius = int(height * 0.24)

    draw.ellipse(
        (
            center_x - radius,
            center_y - radius,
            center_x + radius,
            center_y + radius
        ),
        fill=(205, 46, 58)
    )

    draw.pieslice(
        (
            center_x - radius,
            center_y - radius,
            center_x + radius,
            center_y + radius
        ),
        start=0,
        end=180,
        fill=(0, 71, 160)
    )

    small_radius = radius // 2

    draw.ellipse(
        (
            center_x - radius,
            center_y - small_radius,
            center_x,
            center_y + small_radius
        ),
        fill=(0, 71, 160)
    )

    draw.ellipse(
        (
            center_x,
            center_y - small_radius,
            center_x + radius,
            center_y + small_radius
        ),
        fill=(205, 46, 58)
    )

def draw_us_flag(draw, x, y, width, height):
    # White background
    draw.rectangle(
        (x, y, x + width, y + height),
        fill=(255, 255, 255)
    )

    # 13 red/white stripes
    stripe_height = height / 13

    for i in range(13):
        if i % 2 == 0:
            y1 = round(y + i * stripe_height)
            y2 = round(y + (i + 1) * stripe_height)

            draw.rectangle(
                (x, y1, x + width, y2),
                fill=(178, 34, 52)
            )

    # Blue canton
    canton_width = round(width * 0.40)
    canton_height = round(stripe_height * 7)

    draw.rectangle(
        (
            x,
            y,
            x + canton_width,
            y + canton_height
        ),
        fill=(60, 59, 110)
    )

    # Simplified 50-star layout.
    # At this small size tiny squares render much cleaner
    # than circles or actual star shapes.
    rows = 9

    for row in range(rows):
        stars = 6 if row % 2 == 0 else 5

        for column in range(stars):
            if stars == 6:
                cx = (
                    x
                    + canton_width
                    * (column + 0.5)
                    / 6
                )
            else:
                cx = (
                    x
                    + canton_width
                    * (column + 1)
                    / 6
                )

            cy = (
                y
                + canton_height
                * (row + 0.5)
                / rows
            )

            dot_size = max(
                1,
                round(height * 0.025)
            )

            draw.rectangle(
                (
                    round(cx - dot_size / 2),
                    round(cy - dot_size / 2),
                    round(cx + dot_size / 2),
                    round(cy + dot_size / 2)
                ),
                fill=(255, 255, 255)
            )


FLAG_DRAWERS = {
    "deu": draw_german_flag,
    "eng": draw_us_flag,
    "jpn": draw_japanese_flag,
    "kor": draw_korean_flag,
    "fra": draw_french_flag,
}

def load_state():
    if not os.path.exists(STATE_FILE):
        return {}

    try:
        with open(
            STATE_FILE,
            "r",
            encoding="utf-8"
        ) as file:
            return json.load(file)

    except (json.JSONDecodeError, OSError):
        return {}


def save_state(state):
    temp_file = STATE_FILE + ".tmp"

    with open(
        temp_file,
        "w",
        encoding="utf-8"
    ) as file:
        json.dump(
            state,
            file,
            indent=2,
            ensure_ascii=False
        )

    os.replace(
        temp_file,
        STATE_FILE
    )

def get_movies():
    response = requests.get(
        f"{JELLYFIN_URL}/Items",
        headers=HEADERS,
        params={
            "IncludeItemTypes": "Movie",
            "Recursive": "true",
            "CollapseBoxSetItems": "false",
            "Fields": "MediaStreams",
        },
        timeout=60
    )

    response.raise_for_status()

    return response.json()["Items"]


def download_poster_bytes(item_id):
    response = requests.get(
        f"{JELLYFIN_URL}/Items/{item_id}/Images/Primary",
        headers=HEADERS,
        timeout=60
    )

    response.raise_for_status()

    if not response.content:
        raise ValueError(
            f"Jellyfin returned an empty poster for item {item_id}"
        )

    content_type = response.headers.get(
        "Content-Type",
        ""
    )

    if not content_type.startswith("image/"):
        raise ValueError(
            f"Unexpected poster content type: {content_type}"
        )

    return response.content


def upload_poster(item_id, poster_path):
    with open(poster_path, "rb") as file:
        image_bytes = file.read()

    encoded_image = base64.b64encode(
        image_bytes
    )

    response = requests.post(
        f"{JELLYFIN_URL}/Items/{item_id}/Images/Primary",
        headers={
            **HEADERS,
            "Content-Type": "image/jpeg",
        },
        data=encoded_image,
        timeout=60,
    )

    response.raise_for_status()


def calculate_hash(data):
    return hashlib.sha256(data).hexdigest()


def image_from_bytes(data):
    return Image.open(
        io.BytesIO(data)
    ).convert("RGB")


def save_original_poster(item_id, poster_bytes):
    original_path = os.path.join(
        ORIGINAL_DIR,
        f"{item_id}.jpg"
    )

    with open(original_path, "wb") as file:
        file.write(poster_bytes)

    print(
        f"  Saved original poster: {original_path}"
    )


def calculate_file_hash(path):
    with open(path, "rb") as file:
        return calculate_hash(
            file.read()
        )


def safe_filename(name):
    return re.sub(
        r"[^a-zA-Z0-9äöüÄÖÜß ._()]",
        "_",
        name
    )

def select_display_languages(languages):
    unique_languages = []

    for language in languages:
        if (
            language in FLAG_DRAWERS
            and language not in unique_languages
        ):
            unique_languages.append(language)

    selected = []

    # German always first
    if "deu" in unique_languages:
        selected.append("deu")

    # English always second if available
    if "eng" in unique_languages:
        selected.append("eng")

    # Fill remaining space with other languages
    for language in unique_languages:
        if language in selected:
            continue

        selected.append(language)

        if len(selected) == 3:
            break

    return selected[:3]


def add_flags(poster, languages):
    supported_languages = select_display_languages(
    languages
)

    if not supported_languages:
        return poster

    draw = ImageDraw.Draw(poster)

    poster_width, poster_height = poster.size

    flag_height = max(
        24,
        int(poster_height * 0.03)
    )

    flag_width = int(
        flag_height * 1.5
    )

    margin = int(
        flag_height * 0.35
    )

    gap = int(
        flag_height * 0.18
    )

    total_width = (
        len(supported_languages) * flag_width
        + (len(supported_languages) - 1) * gap
    )

    x = (
        poster_width
        - margin
        - total_width
    )

    y = margin

    for language in supported_languages:
        drawer = FLAG_DRAWERS[language]

        drawer(
            draw,
            x,
            y,
            flag_width,
            flag_height
        )

        x += flag_width + gap

    return poster


def process_movie(movie, state):
    name = movie["Name"]
    item_id = movie["Id"]

    languages = get_languages(movie)

    selected_languages = select_display_languages(
        languages
    )

    print(
        f"{name}: "
        f"{', '.join(selected_languages) if selected_languages else 'none'}"
    )

    if not selected_languages:
        print("  No supported language flag")
        return False

    previous_state = state.get(
        item_id,
        {}
    )

    try:
        current_poster_bytes = download_poster_bytes(
            item_id
        )

    except (requests.HTTPError, ValueError) as error:
        print(
            f"  Could not download poster: {error}"
        )
        return False

    current_hash = calculate_hash(
        current_poster_bytes
    )

    generated_hash = previous_state.get(
        "generated_hash"
    )

    previous_languages = previous_state.get(
        "languages",
        []
    )

    poster_was_changed = (
        generated_hash is not None
        and current_hash != generated_hash
    )

    first_run = (
        generated_hash is None
    )

    languages_changed = (
        previous_languages != selected_languages
    )

    if (
        not FORCE_REBUILD
        and not first_run
        and not poster_was_changed
        and not languages_changed
    ):
        print("  Unchanged, skipping")
        return False

    original_path = os.path.join(
        ORIGINAL_DIR,
        f"{item_id}.jpg"
    )

    if FORCE_REBUILD and os.path.exists(original_path):
        print("  Force rebuild from saved original")

        with open(original_path, "rb") as file:
            original_poster_bytes = file.read()

    elif first_run or poster_was_changed:
        original_poster_bytes = current_poster_bytes

        save_original_poster(
            item_id,
            original_poster_bytes
        )

        if poster_was_changed:
            print(
                "  New Jellyfin poster detected"
            )

    else:
        if not os.path.exists(original_path):
            print(
                "  Original poster missing, skipping"
            )
            return False

        with open(original_path, "rb") as file:
            original_poster_bytes = file.read()

    original_hash = calculate_hash(
        original_poster_bytes
    )

    poster = image_from_bytes(
        original_poster_bytes
    )

    poster = add_flags(
        poster,
        selected_languages
    )

    output_filename = (
        safe_filename(name)
        + ".jpg"
    )

    output_path = os.path.join(
        OUTPUT_DIR,
        output_filename
    )

    poster.save(
        output_path,
        "JPEG",
        quality=95
    )

    new_generated_hash = calculate_file_hash(
        output_path
    )

    try:
        upload_poster(
            item_id,
            output_path
        )

    except requests.HTTPError as error:
        print(
            f"  Could not upload poster: {error}"
        )
        return False


    state[item_id] = {
        "name": name,
        "languages": selected_languages,
        "original_hash": original_hash,
        "generated_hash": new_generated_hash,
        "output": output_filename,
    }

    print(
        f"  Saved: {output_path}"
    )

    print(
        "  Uploaded poster to Jellyfin"
    )

    return True


def main():
    os.makedirs(
        OUTPUT_DIR,
        exist_ok=True
    )

    os.makedirs(
        ORIGINAL_DIR,
        exist_ok=True
    )

    state = load_state()

    movies = get_movies()

    print(
        f"Found {len(movies)} movies"
    )


    changed = False

    for movie in movies:
        if process_movie(
            movie,
            state
        ):
            changed = True

    if changed:
        save_state(
            state
        )

        print(
            "State saved"
        )

    else:
        print(
            "Nothing changed"
        )


if __name__ == "__main__":
    main()
server:
  assets-path: /app/assets

pages:
  - name: Home
    columns:
      - size: small
        widgets:
          - type: server-stats

      - size: full
        widgets:
          - type: search
            search-engine: google

          - type: monitor
            title: Core Services
            cache: 1m
            sites:
{% for service in glance_services.core %}
              - title: {{ service.name }}
                url: {{ service.url }}
                icon: {{ service.icon }}
{% if homelab_services.core.adguard | default(false) %}
                allow-insecure: true
                timeout: 10s
{% endif %}
{% endfor %}

          - type: monitor
            title: Media Services
            cache: 1m
            sites:
{% for service in glance_services.media %}
              - title: {{ service.name }}
                url: {{ service.url }}
                icon: {{ service.icon }}
{% if homelab_services.core.adguard | default(false) %}
                allow-insecure: true
                timeout: 10s
{% endif %}
{% endfor %}

          - type: monitor
            title: Monitoring
            cache: 1m
            sites:
{% for service in glance_services.monitoring %}
              - title: {{ service.name }}
                url: {{ service.url }}
                icon: {{ service.icon }}
{% if homelab_services.core.adguard | default(false) %}
                allow-insecure: true
                timeout: 10s
{% endif %}
{% endfor %}
services:
  glance:
    image: glanceapp/glance:latest
    container_name: glance
    restart: unless-stopped

{% if homelab_services.core.adguard | default(false) %}
    dns:
      - "{{ homelab_server_ip }}"
{% endif %}

{% if homelab_services.core.nginx_proxy_manager | default(false) %}
    expose:
      - "8080"
{% else %}
    ports:
      - "{{ Glance }}:8080"
{% endif %}

    volumes:
      - "{{ homelab_config_dir }}/glance:/app/config"
      - "{{ homelab_config_dir }}/glance/assets:/app/assets"

    networks:
      - "{{ docker_network_name }}"

networks:
  {{ docker_network_name }}:
    external: true
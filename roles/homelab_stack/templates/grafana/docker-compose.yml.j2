services:
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    ports:
      - "{{ Grafana }}:3000"
    volumes:
      - "{{ homelab_config_dir }}/grafana/data:/var/lib/grafana"
    networks:
      - "{{ docker_network_name }}"

networks:
  {{ docker_network_name }}:
    external: true
{% for host in homelab_proxy_hosts %}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ host.domain }};

    ssl_certificate /etc/nginx/certs/homelab.crt;
    ssl_certificate_key /etc/nginx/certs/homelab.key;

    client_max_body_size 0;

    location / {
{% if not host.allow_restricted_clients | default(false) %}
{% for ip in wireguard_restricted_clients %}
        deny {{ ip }};
{% endfor %}
        allow all;
{% endif %}

        proxy_pass {{ host.upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
{% endfor %}
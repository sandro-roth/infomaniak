{% for host in homelab_proxy_hosts %}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ host.domain }};

    ssl_certificate /etc/letsencrypt/live/{{ homelab_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ homelab_certificate_name }}/privkey.pem;

    client_max_body_size 0;

    location / {
{% if not host.allow_restricted_clients | default(false) %}
{% for ip in wireguard_restricted_clients %}
        deny {{ ip }};
{% endfor %}
        allow all;
{% endif %}

        proxy_pass {{ host.upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

{% if host.fix_http_redirect | default(false) %}
        proxy_redirect http://{{ host.domain }}/ https://{{ host.domain }}/;
{% endif %}

{% if host.websocket_upgrade | default(true) %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }
}
{% endfor %}
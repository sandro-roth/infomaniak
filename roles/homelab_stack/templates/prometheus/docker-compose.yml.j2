services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped
    ports:
      - "{{ Prometheus }}:9090"
    volumes:
      - "{{ homelab_config_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - "{{ docker_network_name }}"

networks:
  {{ docker_network_name }}:
    external: true